# Plantilla de variables de entorno (ver docs/15-entorno-y-prerrequisitos.md §4).
# Copiar a .env para desarrollo local. NUNCA subir valores reales al repositorio.

# --- General ---
APP_ENV=local
NODE_ENV=development
API_BASE_URL=http://localhost:8080

# --- Base de datos ---
DATABASE_URL=postgresql://app:app@localhost:5432/app

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
# Número de proyecto (no el ID): lo exige el registro del suscriptor de webhooks
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_REGION=europe-southwest1

# --- Google Health API (OAuth 2.0, cliente de tipo "Aplicación web") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/connections/google/callback
GOOGLE_HEALTH_API_BASE_URL=https://health.googleapis.com/v4
# Ámbitos mínimos (docs/10-integracion-google-health-api.md §3)
GOOGLE_HEALTH_SCOPES="https://www.googleapis.com/auth/googlehealth.health_metrics_and_measurements.readonly https://www.googleapis.com/auth/googlehealth.sleep.readonly https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly https://www.googleapis.com/auth/googlehealth.settings.readonly"
# Secreto que Google envía en la cabecera Authorization de cada webhook
GOOGLE_HEALTH_WEBHOOK_SECRET=
# Claves públicas para verificar la firma GOOGLE-HEALTH-API-SIGNATURE (Tink)
GOOGLE_HEALTH_WEBHOOK_KEYSET_URL=https://www.gstatic.com/googlehealthapi/webhooks/webhooks_public_keyset.json

# --- Cifrado de tokens OAuth ---
# Producción: nombre completo de la clave de Cloud KMS
TOKEN_ENCRYPTION_KMS_KEY=
# Solo local: clave de 32 bytes en base64 (openssl rand -base64 32)
TOKEN_ENCRYPTION_LOCAL_KEY=

# --- Sesiones de nuestra app ---
SESSION_JWT_SECRET=

# --- Sign in with Apple (iOS) ---
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_PRIVATE_KEY=

# --- Notificaciones push (Expo) ---
EXPO_ACCESS_TOKEN=

# --- Coach IA (API de Claude, solo backend) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
COACH_DAILY_MESSAGE_LIMIT=40
COACH_DAILY_TOKEN_LIMIT=400000

# --- Observabilidad ---
SENTRY_DSN=

# --- App móvil (pública, no secreta) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

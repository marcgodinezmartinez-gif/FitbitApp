// Plantilla de configuración de la app (ver docs/15-entorno-y-prerrequisitos.md §4).
// En GitHub Actions, Config/Secrets.xcconfig se genera a partir de los secretos del repositorio.
// Para compilar en otro entorno, copiarla a Config/Secrets.xcconfig (ignorado por Git) y rellenarla.
// Ojo: en los .xcconfig "//" inicia un comentario, así que aquí no se ponen URLs.

// Identificador de la app y equipo de firma de Apple
APP_BUNDLE_ID = com.example.recupera
DEVELOPMENT_TEAM =

// Cliente OAuth de tipo iOS creado en Google Cloud (Google Auth Platform > Clients)
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =

// Las claves de IA del Coach (Claude o Gemini) NO van aquí:
// se introducen en Ajustes de la app y se guardan en el Llavero.

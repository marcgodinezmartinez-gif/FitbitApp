// Plantilla de configuración de la app (ver docs/15-entorno-y-prerrequisitos.md §4).
// Copiar a Config/Secrets.xcconfig (ignorado por Git) y rellenar con tus valores.
// Ojo: en los .xcconfig "//" inicia un comentario, así que aquí no se ponen URLs.

// Identificador de la app y equipo de firma de Apple
APP_BUNDLE_ID = com.example.recupera
DEVELOPMENT_TEAM =

// Cliente OAuth de tipo iOS creado en Google Cloud (Google Auth Platform > Clients)
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =

// La clave de la API de Anthropic (Coach IA opcional) NO va aquí:
// se introduce en Ajustes de la app y se guarda en el Llavero.
